# theugc.life — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Names and descriptions only. Every assignment is empty on purpose.
# Validation for the public and server split lives in src/env.ts and src/lib/env.server.ts.

# --- Public (safe to expose to the browser; must be NEXT_PUBLIC_*) ----------
# Supabase project URL. Inlined into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Public by design. Authorization is RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Deployed site URL. Auth email links and the Netlify job fallback use it.
# Netlify also sets URL. Local example of the shape: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Product analytics. If unset, analytics is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host. If unset, the client uses its own default.
NEXT_PUBLIC_POSTHOG_HOST=
# Google Maps JavaScript API (optional, D079). If unset, Discover and Hotel
# Detail show no map and no error. Set at build time. Restrict the key to
# HTTP referrers and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Server-only (NEVER exposed to the browser) -----------------------------
# Supabase service-role key. Bypasses RLS. Trusted server code only.
# Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for migration and operator scripts.
DATABASE_URL=
# Runtime mode. Does not open Gmail sending. "test" refuses a real Gmail
# and Claude network call from the adapters.
NODE_ENV=
# Read by the server env schema. It does not authorize the Rebill webhook
# (D138). The webhook secret is REBILL_WEBHOOK_SIGNING_SECRET.
BILLING_WEBHOOK_SECRET=

# --- Rebill (server). Never commit real keys. Live charges stay off. -------
# Secret API key. Server only. Not NEXT_PUBLIC_.
REBILL_SECRET_KEY=
# Public key. The hosted checkout does not require it in the browser.
REBILL_PUBLIC_KEY=
# Webhook signing secret. HMAC-SHA256 of the raw body, header
# x-rebill-signature. No timestamp. Server only.
REBILL_WEBHOOK_SIGNING_SECRET=
# Exactly "true" allows a hosted link against a productive Rebill
# organization. Any other value, including unset, keeps live charges off.
REBILL_LIVE=

# --- Contacts (server). Never commit a real key. Not NEXT_PUBLIC_. ---------
# Unset or "fake" is the local and CI provider. "hunter" calls Hunter.
# Any other value refuses to start.
CONTACT_PROVIDER=
# Hunter secret. Server only. Empty refuses a Hunter lookup.
HUNTER_API_KEY=
# Exactly true, 1, or yes fails closed before any Hunter call.
HUNTER_DISABLED=
# Unset or "heuristic" is the only approved collaboration classifier.
GMAIL_COLLAB_CLASSIFIER=
# Unset uses the template personalizer. Any other value must be a wired adapter.
PITCH_PERSONALIZER=

# --- Anthropic Claude (server). Never commit a real key. Not NEXT_PUBLIC_. ---
# Empty or shorter than 8 characters refuses AI drafts. Template drafts still work.
ANTHROPIC_API_KEY=
# Unset means Claude Sonnet (latest). Pro and Max use the same model.
ANTHROPIC_MODEL=
# Optional output ceilings. The server clamps them.
ANTHROPIC_PRIORITY_MAX_TOKENS=
ANTHROPIC_PRO_MAX_TOKENS=
# Optional context ceilings, in characters. The server clamps them.
ANTHROPIC_PRIORITY_CONTEXT_CHARS=
ANTHROPIC_PRO_CONTEXT_CHARS=
# Hard stop for estimated spend in the current UTC month, in US dollars.
# Unset or not a positive number refuses every model call.
ANTHROPIC_MONTHLY_BUDGET_USD=
# Optional price overrides, US dollars per million tokens.
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=
# Optional per-plan estimated budget ceilings, in US dollars.
AI_BUDGET_MAX_USD=
AI_BUDGET_PRO_USD=
# Optional regeneration weight. The server clamps it.
AI_REGEN_WEIGHT=
# Optional share of the monthly budget held as a global pool, as a percent.
AI_GLOBAL_POOL_PERCENT=

# --- Gmail OAuth (server). Never commit a secret. Not NEXT_PUBLIC_. --------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact redirect URI registered with Google.
GOOGLE_OAUTH_REDIRECT_URI=
# Base64 key used to seal refresh tokens at rest. Version v1.
GMAIL_TOKEN_ENCRYPTION_KEY_V1=

# --- Gmail send (server). ---------------------------------------------------
# Exactly true, 1, or yes disables every send. Unset leaves sending enabled.
GMAIL_SEND_DISABLED=
# Unrestricted sending is on only when this is exactly production.
# Leave it unset on staging, previews, and local machines. NODE_ENV does
# not open sending.
GMAIL_SEND_ENV=
# When GMAIL_SEND_ENV is not production, an unset list allows only
# hello@theugc.life. A set list is enforced even when sending is open.
# Comma-separated addresses.
GMAIL_SEND_ALLOWLIST=
# Optional soft daily caps. Blank or not an integer stays at Pro 120 and Max 300.
GMAIL_SEND_PRO_DAILY_CAP=
GMAIL_SEND_MAX_DAILY_CAP=
# Bearer for the send dispatcher. Shorter than 16 characters fails closed.
GMAIL_DISPATCH_SECRET=

# --- Scheduled jobs (server). Each secret is its own. Shorter than 16
# characters, or unset, fails closed. Netlify sets URL to the site origin.
URL=
GMAIL_SYNC_SECRET=
ACCOUNT_ERASURE_SECRET=
CREDIT_PERIOD_SECRET=
GMAIL_FOLLOWUP_SECRET=

# --- Operator scripts, evaluation, and end-to-end tests --------------------
# Postgres for the RLS suite. When unset, those tests skip.
TEST_DATABASE_URL=
# Postgres for Playwright mailbox setup.
E2E_DATABASE_URL=
# Playwright base URL. Unset uses http://127.0.0.1:3000.
E2E_BASE_URL=
# Extra forbidden substrings for the client-bundle secret scan.
CLIENT_BUNDLE_EXTRA_FORBIDDEN=
# Set by CI. A missing production client bundle fails closed only when this is set.
CI=
# Property-source evaluation. Never read by the application. Absent values
# mark the provider not available.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SHARED_SECRET=
NUITEE_API_KEY=
EVAL_RUN_LABEL=
# Benchmark transports. The application does not read these.
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
# Benchmark model override. The code reads B07_BENCH_MODEL_<CANDIDATE_ID>,
# with the candidate id uppercased and non-alphanumerics turned into
# underscores. Do not invent one candidate name here.
