# theugc.life — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Validation lives in src/env.ts (client vs server split).

# --- Public (safe to expose to the browser; must be NEXT_PUBLIC_*) ----------
# Supabase project URL and anon (publishable) key. The anon key is public by
# design; all authorization is enforced by RLS server-side.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# The deployed site URL (used for auth email redirect links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Product analytics (optional). If unset, analytics is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Google Maps JavaScript API (optional, D079). Placeholder only — do not put a
# real key here. If unset, Discover and Hotel Detail show no map and no error.
# Production: set this at build time (Next inlines NEXT_PUBLIC_*). Restrict the
# key to HTTP referrers and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Server-only (NEVER exposed to the browser) -----------------------------
# Supabase service-role key. Bypasses RLS. Used only by trusted server code
# (payment webhooks, admin jobs). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection for migration/admin scripts (optional locally).
# e.g. postgres://postgres:postgres@localhost:54322/postgres
DATABASE_URL=""

# --- Property-source evaluation (optional, evaluation tooling only) ---------
# Used ONLY by scripts/provider-evaluation/. Never read by the application, and
# never committed. Absent values simply mark the provider NOT AVAILABLE.
# HBX Group / Hotelbeds — the ACTIVE evaluation source. Real values live only in
# the gitignored .env.local and must never appear here.
HOTELBEDS_API_KEY=""
HOTELBEDS_SECRET=""
BOOKING_DEMAND_API_TOKEN=""
BOOKING_AFFILIATE_ID=""
EXPEDIA_RAPID_API_KEY=""
EXPEDIA_RAPID_SHARED_SECRET=""
NUITEE_API_KEY=""

# --- Rebill (server). Never commit real keys. Live charges stay off. -------
# Secret API key (sk_...). Server only. Not NEXT_PUBLIC_.
REBILL_SECRET_KEY=""
# Public key (pk_...). Safe to expose. The hosted checkout does not require it
# in the browser.
REBILL_PUBLIC_KEY=""
# Webhook signing secret (whsec_...). HMAC of the raw body. Server only.
REBILL_WEBHOOK_SIGNING_SECRET=""
# Exactly "true" allows a hosted link against a productive Rebill organization.
# Any other value, including unset, keeps live charges off. Sandbox links can
# still open when REBILL_SECRET_KEY is set. POST /v3/checkout is never called.
REBILL_LIVE=""

# --- Anthropic Claude (server). Never commit a real key. Not NEXT_PUBLIC_. ---
# Empty refuses AI drafts. Template drafts still work. Pro and Max use the
# same model. Unset ANTHROPIC_MODEL means Claude Sonnet (latest).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Hard stop for estimated spend in the current UTC month, in US dollars.
# Unset or not a positive number refuses every model call.
ANTHROPIC_MONTHLY_BUDGET_USD=""
# Optional. The server clamps these to a tight ceiling.
ANTHROPIC_USER_DAILY_CALLS=""
ANTHROPIC_USER_DAILY_TOKENS=""

# --- Gmail send (server). Never commit a token. Not NEXT_PUBLIC_. ----------
# Exactly true, 1, or yes disables every send. Unset leaves sending enabled.
GMAIL_SEND_DISABLED=""
# Outside production an unset list allows only hello@theugc.life. Staging
# should set that address explicitly. Production allows any recipient unless
# this is set. Comma-separated addresses.
GMAIL_SEND_ALLOWLIST=""
# Optional. The database clamps a higher value to 40 and a lower value to 1.
# Unset means 20 provider attempts per creator per UTC day.
GMAIL_SEND_DAILY_LIMIT=""

# --- Test-only --------------------------------------------------------------
# Postgres connection used by the RLS test suite. When unset, RLS tests skip.
# e.g. postgres://postgres:postgres@localhost:5432/postgres
TEST_DATABASE_URL=""
