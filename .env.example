# theugc.life — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Validation lives in src/env.ts (client vs server split).

# --- Public (safe to expose to the browser; must be NEXT_PUBLIC_*) ----------
# Supabase project URL and anon (publishable) key. The anon key is public by
# design; all authorization is enforced by RLS server-side.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# The deployed site URL (used for auth email redirect links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Product analytics (optional). If unset, analytics is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Server-only (NEVER exposed to the browser) -----------------------------
# Supabase service-role key. Bypasses RLS. Used only by trusted server code
# (payment webhooks, admin jobs). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection for migration/admin scripts (optional locally).
# e.g. postgres://postgres:postgres@localhost:54322/postgres
DATABASE_URL=""

# --- Property-source evaluation (optional, evaluation tooling only) ---------
# Used ONLY by scripts/provider-evaluation/. Never read by the application, and
# never committed. Absent values simply mark the provider NOT AVAILABLE.
# HBX Group / Hotelbeds — the ACTIVE evaluation source. Real values live only in
# the gitignored .env.local and must never appear here.
HOTELBEDS_API_KEY=""
HOTELBEDS_SECRET=""
BOOKING_DEMAND_API_TOKEN=""
BOOKING_AFFILIATE_ID=""
EXPEDIA_RAPID_API_KEY=""
EXPEDIA_RAPID_SHARED_SECRET=""
NUITEE_API_KEY=""

# --- Test-only --------------------------------------------------------------
# Postgres connection used by the RLS test suite. When unset, RLS tests skip.
# e.g. postgres://postgres:postgres@localhost:5432/postgres
TEST_DATABASE_URL=""
