{
  "name": "theugc-life",
  "version": "0.0.0",
  "private": true,
  "description": "theugc.life \u2014 the operating system for travel UGC creators.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "db:test:setup": "tsx scripts/apply-migrations.ts --bootstrap",
    "eval:sources:status": "tsx scripts/provider-evaluation/run.ts --status",
    "eval:sources:pilot-probe": "tsx scripts/provider-evaluation/pilot-probe.ts",
    "eval:sources:probe": "NODE_USE_ENV_PROXY=1 tsx scripts/provider-evaluation/run.ts --probe",
    "eval:sources:geography": "NODE_USE_ENV_PROXY=1 tsx scripts/provider-evaluation/run.ts --discover-geography",
    "eval:sources:categories": "NODE_USE_ENV_PROXY=1 tsx scripts/provider-evaluation/run.ts --category-master",
    "import:inspect": "tsx scripts/import/inspect.ts",
    "import:stage": "tsx scripts/import/stage.ts",
    "import:dry-run": "tsx scripts/import/dry-run.ts",
    "import:report": "tsx scripts/import/report.ts",
    "import:db-preflight": "tsx scripts/import/db-preflight.ts",
    "import:review-template": "tsx scripts/import/review-template.ts",
    "import:review-apply": "tsx scripts/import/review-apply.ts",
    "import:promote": "tsx scripts/import/promote.ts",
    "destination:list": "tsx scripts/import/destination/list.ts",
    "destination:upsert": "tsx scripts/import/destination/upsert.ts",
    "destination:alias": "tsx scripts/import/destination/alias.ts",
    "eval:sources:accommodation-types": "NODE_USE_ENV_PROXY=1 tsx scripts/provider-evaluation/run.ts --accommodation-types",
    "eval:sources:extract": "NODE_USE_ENV_PROXY=1 tsx scripts/provider-evaluation/run.ts --provider hotelbeds",
    "eval:sources:pilot-compare": "tsx scripts/provider-evaluation/run.ts --pilot-compare",
    "source:ingest": "tsx scripts/provider-ingestion/ingest.ts",
    "source:resolve": "tsx scripts/provider-resolution/resolve.ts",
    "source:match": "tsx scripts/entity-resolution/match.ts",
    "source:match:review": "tsx scripts/entity-resolution/review.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "^15.5.23",
    "papaparse": "^5.5.4",
    "posthog-js": "^1.203.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.12",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "supabase": "2.114.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
